{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["local>rtuszik/renovate-config"],
    "customManagers": [
        {
            "customType": "regex",
            "description": "Update annotated build args shared across Dockerfile stages",
            "managerFilePatterns": ["/(^|/|\\.)Dockerfile$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\sARG [A-Z_]+=(?<currentValue>.+?)\\s"
            ]
        },
        {
            "customType": "regex",
            "description": "Update the MCP Inspector version pinned in the HTTP tests",
            "managerFilePatterns": ["/^tests/test_http\\.py$/"],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>\\S+)\\s+[A-Z_]+ = \"(?<currentValue>[^\"]+)\""
            ]
        }
    ]
}
